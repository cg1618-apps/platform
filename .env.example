# The platform's own environment.
#
# This is NOT an application's .env. It holds the PostgreSQL superuser and the
# tunnel's identity, and no application container is ever handed it: each app's
# compose project gives its own service its own .env, which is what keeps an
# application from holding credentials for the database of every other one.
#
# Compose loads this directory's .env because the compose file lives here.

COMPOSE_PROJECT_NAME=cg1618

# PostgreSQL superuser. Each application gets its own database; this is the
# account that creates them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# The maintenance database the container initialises on first start. Each
# application's database is created beside it.
POSTGRES_DB=postgres

# The Cloudflare Tunnel. TUNNEL_ID is not a secret and is passed on the command
# line, which is what keeps cloudflared/config.yml static and committable. The
# credentials JSON is a secret; this names an absolute path to it on the box,
# mounted read-only.
TUNNEL_ID=
CLOUDFLARED_CREDENTIALS=/home/cgentle1618/.cloudflared/<tunnel-id>.json
