# Each app is its own repository, cloned inside this one. The two histories
# never see each other, which is what makes the nesting safe.
/media/
/art/
/food/
/journal/
/health/
/money/
/travel/
# ...and so are each app's worktrees, which its helper creates beside it as
# ../<app>_<topic>, landing here too.
/media_*/
/art_*/
/food_*/
/journal_*/
/health_*/
/money_*/
/travel_*/

# Per-machine, never committed.
CLAUDE.local.md
.env
credentials.json

__pycache__/
*.pyc
.venv/
venv/

# Per-session Claude Code permissions, per-machine like the rest of this block.
.claude/settings.local.json
