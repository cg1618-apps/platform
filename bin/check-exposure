#!/usr/bin/env bash
# Check that an application's ACTUAL exposure matches the one apps.yml claims.
#
#   ./bin/check-exposure <app>        one live app
#   ./bin/check-exposure --all        every app the registry calls live
#
# `exposure:` in the registry is a statement of intent. Cloudflare Access is
# configured in a dashboard this repository cannot see, so nothing connected
# the two - and art.cg1618.com served an unauthenticated 200 for twenty
# minutes while the registry called it cloudflare-access. Its DNS record had
# been created without an Access application behind it, which looks identical
# to a working one from everywhere except the open internet.
#
# So this asks the open internet. Unlike bin/health, which deliberately probes
# from inside the container because a tunnel hiccup must not roll back good
# code, the path a stranger takes is the whole point here.
#
# Exit codes:
#   0  every app checked matches its declaration
#   1  the check could not be run
#   2  an app's real exposure contradicts the registry

set -euo pipefail

PLATFORM_DIR="$(cd "$(dirname "$0")/.." && pwd)"

APP=""
ALL=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --all) ALL=1 ;;
        -*)    echo "unknown option: $1" >&2; exit 1 ;;
        *)     if [ -n "${APP}" ]; then
                   echo "unexpected argument '$1'." >&2
                   exit 1
               fi
               APP="$1" ;;
    esac
    shift
done

if [ "${ALL}" -eq 0 ] && [ -z "${APP}" ]; then
    echo "usage: check-exposure <app> | --all" >&2
    exit 1
fi

# Only `live` apps have a hostname anybody can reach; a planned app is
# unrouted by construction and would fail on DNS rather than on anything
# meaningful.
#
# The newline is written explicitly. print() translates it to CRLF on Windows,
# where the development machines are, and the trailing CR then rides into
# `exposure` and matches none of the cases below - passing on the box and
# failing here, which is the worst way round.
targets="$(python3 -c '
import sys, yaml
want = sys.argv[1]
apps = yaml.safe_load(open(sys.argv[2]))["apps"]
live = [a for a in apps if a.get("status") == "live"]
if want != "--all":
    named = [a for a in apps if a["name"] == want]
    if not named:
        sys.exit(f"{want} is not in apps.yml")
    # In the registry but not live is a legitimate no-op, not a
    # failure: a planned app is unrouted by construction. Saying
    # otherwise would fail the deploy of every app before the
    # release that publishes its hostname.
    live = [a for a in named if a.get("status") == "live"]
for a in live:
    # Paths are joined with commas and default to "-": the shell reads these
    # lines field by field on whitespace, so a field must never be empty or
    # contain a space. No backticks in here either - this whole block is one
    # single-quoted shell word, and shellcheck reads a backtick in it as a
    # command substitution that will not expand (SC2016).
    gated = ",".join(a.get("gated_paths") or []) or "-"
    line = (
        a["name"] + " " + a["hostname"] + " " + a["exposure"] + " " + gated + chr(10)
    )
    sys.stdout.buffer.write(line.encode())
' "${APP:---all}" "${PLATFORM_DIR}/apps.yml")"

if [ -z "${targets}" ]; then
    if [ "${ALL}" -eq 1 ]; then
        echo "No live apps to check." >&2
        exit 1
    fi
    echo "${APP} is not live in apps.yml - nothing routed to it, nothing to check."
    exit 0
fi

failed=0

while read -r name hostname exposure gated_paths; do
    [ -n "${name}" ] || continue

    # No --retry: the answer this script gives is a security claim, and a
    # transient failure should say so rather than be smoothed over.
    headers="$(curl -sS -D - -o /dev/null --max-time 20 "https://${hostname}" 2>&1)" || {
        echo "${name}: could not reach ${hostname}" >&2
        echo "${headers}" >&2
        exit 1
    }

    status="$(printf '%s' "${headers}" | awk 'NR==1{print $2}')"

    # An Access-protected hostname redirects an unauthenticated request to the
    # team's login domain. That redirect IS the gate, so its presence is the
    # check - not the status code, which is 302 for plenty of other reasons.
    gated=0
    if printf '%s' "${headers}" | grep -qi '^location:.*cloudflareaccess\.com'; then
        gated=1
    fi

    case "${exposure}" in
        cloudflare-access)
            if [ "${gated}" -eq 1 ]; then
                echo "${name}: gated by Access, as declared (${status})"
            else
                echo "${name}: DECLARED cloudflare-access BUT ANSWERS ${status} UNGATED" >&2
                echo "  ${hostname} reaches the box without authenticating. Either add" >&2
                echo "  an Access application covering it, or remove its DNS record." >&2
                failed=1
            fi
            ;;
        public)
            if [ "${gated}" -eq 1 ]; then
                # Not a hole, but the registry is wrong about the system, and
                # this exists to catch that in either direction.
                echo "${name}: declared public but sits behind Access" >&2
                failed=1
            else
                echo "${name}: public, as declared (${status})"
            fi
            ;;
        *)
            echo "${name}: exposure '${exposure}' is not one this script knows" >&2
            failed=1
            ;;
    esac

    # A public app's ROOT answering ungated is correct and says nothing about
    # its write surface. This is the only thing that asks about the prefix -
    # and it is asked from the open internet, because a gate configured in a
    # dashboard this repository cannot see is exactly what went wrong on art.
    #
    # Access answers before the request reaches the box, so the redirect is
    # present whatever the app itself would have returned for a GET on a write
    # prefix - 404, 405 and 200 all mean the same thing here: not gated.
    if [ "${gated_paths}" = "-" ]; then
        continue
    fi

    old_ifs="${IFS}"
    IFS=','
    # shellcheck disable=SC2086
    set -- ${gated_paths}
    IFS="${old_ifs}"

    probed_parents=""

    for path in "$@"; do
        ph="$(curl -sS -D - -o /dev/null --max-time 20 "https://${hostname}${path}" 2>&1)" || {
            echo "${name}: could not reach ${hostname}${path}" >&2
            echo "${ph}" >&2
            exit 1
        }
        pstatus="$(printf '%s' "${ph}" | awk 'NR==1{print $2}')"
        if printf '%s' "${ph}" | grep -qi '^location:.*cloudflareaccess\.com'; then
            echo "${name}: ${path} gated by Access, as declared (${pstatus})"
        else
            echo "${name}: ${path} IS DECLARED GATED BUT ANSWERS ${pstatus} UNGATED" >&2
            echo "  ${hostname}${path} reaches the app without authenticating." >&2
            echo "  A public hostname with an ungated write prefix is a public" >&2
            echo "  editor. Extend the Access application to cover ${path}, or" >&2
            echo "  remove it from gated_paths in apps.yml if it is not a write" >&2
            echo "  surface." >&2
            failed=1
        fi

        # The same question asked the other way round: did anything ELSE get
        # gated along with it? An Access policy written as a path prefix is one
        # typo from covering /api instead of /api/edit, and the result is a
        # fully working application nobody can read without signing in. Every
        # container is healthy, the probe above still passes, and the person who
        # finds out is whoever opens the site on a phone.
        #
        # The parent is DERIVED rather than declared - strip the last segment,
        # so /api/edit probes /api. A list of an app's read paths would be a
        # second list to drift, and a check asserting a stale set goes green
        # against paths nobody serves any more.
        parent="${path%/*}"
        # A single-segment prefix derives the root, which the hostname probe
        # above already covers for a public app.
        [ -n "${parent}" ] || continue
        # Two gated prefixes under one parent would otherwise probe it twice.
        case " ${probed_parents} " in *" ${parent} "*) continue ;; esac
        probed_parents="${probed_parents} ${parent}"

        oh="$(curl -sS -D - -o /dev/null --max-time 20 "https://${hostname}${parent}" 2>&1)" || {
            echo "${name}: could not reach ${hostname}${parent}" >&2
            echo "${oh}" >&2
            exit 1
        }
        ostatus="$(printf '%s' "${oh}" | awk 'NR==1{print $2}')"
        if printf '%s' "${oh}" | grep -qi '^location:.*cloudflareaccess\.com'; then
            echo "${name}: ${parent} IS GATED BUT NOTHING DECLARED IT" >&2
            echo "  ${hostname}${parent} sits just outside ${path}, and the" >&2
            echo "  registry calls this app 'public'. The Access application is" >&2
            echo "  WIDER than ${path} - most likely a prefix typed one segment" >&2
            echo "  short. Nobody can read this app without signing in, and" >&2
            echo "  every container is healthy, which is why nothing else" >&2
            echo "  notices. Narrow the Access policy, or declare ${parent} in" >&2
            echo "  gated_paths if gating it was deliberate." >&2
            failed=1
        else
            echo "${name}: ${parent} ungated, so the gate on ${path} is not too wide (${ostatus})"
        fi
    done
done <<< "${targets}"

if [ "${failed}" -ne 0 ]; then
    echo >&2
    echo "Exposure does not match the registry. See above." >&2
    exit 2
fi

echo "Every live app matches its declared exposure."
