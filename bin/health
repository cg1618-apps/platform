#!/usr/bin/env bash
# Poll an application's health endpoint until it answers, or give up.
#
#   ./bin/health <app> [timeout-seconds] [--app-dir PATH]      (default 180)
#
# Probes from INSIDE the app's container rather than through the tunnel. Going
# out to the app's public hostname and back would make Cloudflare's
# availability part of the deploy's success condition, so a tunnel hiccup would
# roll back perfectly good code - and the tunnel is the one component a deploy
# cannot fix.
#
# The path comes from apps.yml and is never "/". An app that serves a
# single-page frontend answers 200 on any path from its catch-all route, so a
# probe against "/" succeeds with the database down. The registered path is the
# one the app declares says something: the media tracker's opens a session,
# reads the schema's recorded revision and compares it to the head the running
# code expects, so it also fails when the schema and the image disagree - the
# state a half-rolled-back deploy leaves behind and the state every weaker
# probe reports as healthy.

set -euo pipefail

PLATFORM_DIR="$(cd "$(dirname "$0")/.." && pwd)"

APP=""
TIMEOUT=""
APP_DIR=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --app-dir) shift; APP_DIR="${1:?--app-dir needs a path}" ;;
        -*)        echo "unknown option: $1" >&2; exit 1 ;;
        # An app, then a timeout, and nothing after that. A third positional
        # used to replace the timeout silently.
        *)         if [ -z "${APP}" ]; then
                       APP="$1"
                   elif [ -z "${TIMEOUT}" ]; then
                       TIMEOUT="$1"
                   else
                       echo "unexpected argument '$1'." >&2
                       exit 1
                   fi ;;
    esac
    shift
done

[ -n "${APP}" ] || { echo "usage: health <app> [timeout] [--app-dir PATH]" >&2; exit 1; }
timeout="${TIMEOUT:-180}"

# The registry is the source of truth for what a healthy answer even looks
# like, so a probe cannot drift from the ingress that routes to the same port.
#
# Assigned from a command substitution rather than read from a heredoc, so a
# failed lookup is a failed assignment under `set -e`. A heredoc would swallow
# the exit status and probe an empty path.
registry="$(python3 -c '
import sys, yaml
name = sys.argv[1]
apps = yaml.safe_load(open(sys.argv[2]))["apps"]
match = [a for a in apps if a["name"] == name]
if not match:
    sys.exit(f"{name} is not in apps.yml")
print(match[0]["port"], match[0]["health_path"], match[0].get("path", "-"))
' "${APP}" "${PLATFORM_DIR}/apps.yml")"
read -r PORT HEALTH_PATH REG_PATH <<<"${registry}"

# Where the checkout is, in precedence order: --app-dir on the command line,
# the registry's optional `path`, then <apps dir>/<name>. The path used to be
# a caller-supplied workflow input, which let a deploy name one app and point
# at another's checkout - the database came from the registry and the code did
# not, so the dump and the thing deployed were different apps. It is
# registry-derived now, like everything else this script acts on.
#
# "-" is the registry's "absent". `path` forbids whitespace in the schema, so
# the lookup's fields can be word-split, and "-" is not a legal value under it.
if [ -z "${APP_DIR}" ] && [ "${REG_PATH}" != "-" ]; then
    # A leading ~/ is the registry's spelling of $HOME. The shell does not
    # expand a tilde that arrives inside a variable, so it is done here.
    case "${REG_PATH}" in
        "~/"*) APP_DIR="${HOME}/${REG_PATH#\~/}" ;;
        *)     APP_DIR="${REG_PATH}" ;;
    esac
fi
APP_DIR="${APP_DIR:-${APPS_DIR:-${HOME}}/${APP}}"
[ -f "${APP_DIR}/docker-compose.prod.yml" ] || {
    echo "No ${APP_DIR}/docker-compose.prod.yml. Pass --app-dir if this app's checkout is elsewhere." >&2
    exit 1
}

# The APP's compose project, and COMPOSE_PROJECT_NAME is deliberately NOT
# cleared: this reaches into the app's own container. Compose takes the project
# directory from the compose file's own location, so the app's .env - and the
# project name in it - are the ones that apply.
COMPOSE=(docker compose -f "${APP_DIR}/docker-compose.prod.yml")

deadline=$(( $(date +%s) + timeout ))

# An app migrates before it binds, so connection refusals early in the window
# are normal rather than failure. Only the deadline decides, which is why this
# loops rather than checking once after a sleep.
while [ "$(date +%s)" -lt "${deadline}" ]; do
    if "${COMPOSE[@]}" exec -T app python -c \
        "import urllib.request; urllib.request.urlopen('http://localhost:${PORT}${HEALTH_PATH}', timeout=5)" \
        >/dev/null 2>&1; then
        echo "healthy"
        exit 0
    fi
    sleep 5
done

echo "${APP} not healthy after ${timeout}s" >&2
# The logs are the only thing that says WHY, and the caller is a workflow step
# nobody is watching. Without this the failure reaches the owner as a bare
# non-zero exit.
"${COMPOSE[@]}" logs --tail 20 app >&2 || true
exit 1
