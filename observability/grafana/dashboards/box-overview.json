{
  "uid": "cg1618-box-overview",
  "title": "Box overview",
  "description": "The four standing questions about the box: how much is happening, how much of it is wrong, which container, and which request. Provisioned from observability/grafana/dashboards/ in the platform repository - edit it there, not here. How to read it: docs/observability.md.",
  "tags": [
    "cg1618",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Lines, selected range",
      "description": "Everything every container wrote in the window above. Meaningless on its own and meaningful when it CHANGES - a step with no deploy behind it usually means something is retrying in a loop, and a drop usually means something stopped serving.",
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"docker\"}[$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Application errors",
      "description": "The real count, read off the level FIELD rather than searched for as text. Covers the four apps only, because only they emit JSON.\n\nThis panel used to be a text match and over-counted badly. On 2026-09-20 it read 49 for the whole box, of which 40 were Grafana describing itself and 4 were food's STARTUP lines - INFO records whose logger is named uvicorn.error, which is uvicorn's general logger rather than an error logger. The true count for that window was zero.",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=~\".+-app-1\"} | json | level=~\"ERROR|CRITICAL\" [$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Containers reporting",
      "description": "How many containers wrote anything. The box runs TEN: four apps, db, cloudflared, apex, and the collector's own three.\n\nThis is the panel that needs no interpretation. Below ten, something has stopped - a container that stops logging has almost always stopped.",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (container) (count_over_time({job=\"docker\"}[$__range])))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Log volume by container",
      "description": "Who is talking, and when. The quieter apps normally sit at nearly identical counts, because that is the health probe and almost nothing else - so ONE app diverging from its neighbours is the signal, more than any absolute number. A container going quiet matters as much as one going loud.",
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (count_over_time({job=\"docker\"}[$__auto]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "legendFormat": "{{container}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Application errors by app",
      "description": "The same field-based count, split by the app field the applications emit. Use it to answer WHICH app before going looking.\n\nGrouped by app rather than container deliberately: app is what the application calls itself and container is what docker calls the process. They differ by the -app-1 suffix and neither is wrong.",
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (count_over_time({container=~\".+-app-1\"} | json | level=~\"ERROR|CRITICAL\" [$__auto]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "legendFormat": "{{app}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "title": "Recent application errors",
      "description": "The lines behind the two panels above, and the place to start when something is wrong. Empty is the normal state.",
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\".+-app-1\"} | json | level=~\"ERROR|CRITICAL\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "direction": "backward"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "Infrastructure lines matching 'error'",
      "description": "db, cloudflared, apex, loki, alloy and grafana. These are third-party containers that do NOT emit the platform's JSON, so this is a text match and it over-counts - a line merely containing the word appears here.\n\nIt is kept rather than dropped for being noisy, because a PostgreSQL or tunnel error matters more than most application errors and nothing else would show it. Read it as a place to look, never as a count. Grafana dominates it by volume and is almost always describing itself.",
      "id": 7,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"cg1618-.+\"} |~ \"(?i)(error|exception|traceback|critical)\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "direction": "backward"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "One container: $container",
      "description": "Drill-down. Pick a container above; leave Search empty for everything, or type a substring. An empty Loki line filter is a no-op rather than an error, which is why blank is safe.",
      "id": 8,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"$container\"} |= \"$search\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "direction": "backward"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "Find one request: $request_id",
      "description": "The incident tool. Copy X-Request-ID from a failed response and paste it above to get every line that request produced, across whichever container handled it.\n\nA line filter rather than a json parser, so it works on the apps' JSON and on the infrastructure's plain text alike. LEAVE IT BLANK AND IT MATCHES EVERYTHING - an empty filter is a no-op, not a bug.",
      "id": 9,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} |= \"$request_id\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "direction": "backward"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(container)",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "description": "Feeds the drill-down panel; refreshed on load, so a new container appears without editing anything."
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring filter for the drill-down panel. Blank means no filter."
      },
      {
        "name": "request_id",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Paste an X-Request-ID here. Blank matches everything."
      }
    ]
  }
}
